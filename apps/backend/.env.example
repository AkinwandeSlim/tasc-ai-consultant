
# ---------------------------------------------------------------------------
# Sprint 6.2 — n8n business automation
# ---------------------------------------------------------------------------
# FastAPI side (consumed by N8nAutomationGateway)
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://localhost:5678/webhook/tasc/consultation
N8N_SHARED_SECRET=change-me-shared-secret
N8N_SIGNING_SECRET=change-me-signing-secret
N8N_TIMEOUT_SECONDS=15
N8N_MAX_RETRIES=3

# LLM layer (natural-language generation only; deterministic engine always runs first)
# Provider-agnostic. Supported LLM_PROVIDER values: openai, openrouter, groq.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional override for OpenAI-compatible endpoints (e.g. OpenRouter, Groq).
# Leave empty to use the provider default.
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE_STRUCTURED=0.0

# ---------------------------------------------------------------------------
# n8n instance environment (docker-compose / n8n host)
# ---------------------------------------------------------------------------
# Required so Code nodes can read $env.*
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Must match N8N_SHARED_SECRET / N8N_SIGNING_SECRET above
TASC_N8N_SHARED_SECRET=change-me-shared-secret
TASC_N8N_SIGNING_SECRET=change-me-signing-secret
# HMAC is advisory by default because n8n re-serialises the JSON body
TASC_N8N_REQUIRE_SIGNATURE=false

# Which qualification bands trigger the automation fan-out
TASC_QUALIFIED_BANDS=qualified,hot

# Google Sheets
TASC_SHEETS_DOCUMENT_ID=your-google-sheet-id
TASC_SHEETS_TAB_NAME=Leads

# Gmail
TASC_SALES_EMAIL=sales@example.com

# Telegram
TASC_TELEGRAM_CHAT_ID=-1000000000000