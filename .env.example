# =============================================================================
# TASC — Trizen AI Solutions Consultant
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values. Never commit .env to version
# control. See docs/ for field-level documentation.
#
# Required variables are marked [REQUIRED]. All others have sensible defaults.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_ENV=local                          # local | preview | production
APP_NAME=tasc-backend
APP_VERSION=1.0.0
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                     # json | console
API_PREFIX=/api
DOCS_ENABLED=true
SHUTDOWN_GRACE_SECONDS=20

# --- Model Provider (provider-agnostic) ------------------------------------
# Supported LLM_PROVIDER values: openai, openrouter, groq.
# The legacy OPENAI_API_KEY / OPENAI_BASE_URL / LLM_CHAT_MODEL spellings are
# still accepted as aliases.
LLM_PROVIDER=openai
LLM_ENABLED=false                        # Set true to route through LLM engine
LLM_API_KEY=                             # [REQUIRED] for LLM_ENABLED=true
LLM_BASE_URL=                            # Optional proxy / compatible endpoint
LLM_MODEL=gpt-4.1-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE_CONVERSATION=0.3
LLM_TEMPERATURE_STRUCTURED=0.0
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=30.0
LLM_CONNECT_TIMEOUT_SECONDS=5.0
LLM_MAX_RETRIES=1
LLM_STRUCTURED_MODE=schema             # schema | json_object

# --- Retrieval (ChromaDB / RAG) ---------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=trizen_knowledge
CHROMA_MODE=embedded                   # embedded | http
CHROMA_HTTP_URL=                        # Required when mode is http
RAG_TOP_K=5
RAG_SIMILARITY_FLOOR=0.35
RAG_CHUNK_TARGET_TOKENS=650
RAG_CHUNK_OVERLAP_RATIO=0.15
RAG_MAX_CONTEXT_CHUNKS=5
RAG_ENABLE_METADATA_FILTER=true

# --- Conversation & Session -------------------------------------------------
SESSION_TTL_MINUTES=60
SESSION_ABANDON_MINUTES=20
SESSION_STORE=file                     # memory | file | redis
SESSION_STORE_PATH=./data/sessions
REDIS_URL=                              # Required when SESSION_STORE=redis
MESSAGE_MAX_CHARS=2000
HISTORY_FULL_TURNS=8
HISTORY_TOKEN_BUDGET=3000
SESSION_TOKEN_CEILING=60000

# --- Scoring & Recommendation ------------------------------------------------
SCORING_WEIGHTS_PATH=app/resources/scoring/weights.yaml
SCORING_OVERRIDES_PATH=app/resources/scoring/overrides.yaml
BAND_THRESHOLD_WARM=35
BAND_THRESHOLD_QUALIFIED=60
BAND_THRESHOLD_HOT=80
CATALOGUE_PATH=app/resources/catalogue/services.yaml
PAIN_MAPPING_PATH=app/resources/catalogue/pain_mapping.yaml
RECOMMENDATION_CONFIDENCE_FLOOR=0.6
RECOMMENDATION_MAX=3

# --- Automation (n8n) ---------------------------------------------------------
N8N_WEBHOOK_URL=                        # [REQUIRED] n8n webhook endpoint
N8N_SHARED_SECRET=                      # [REQUIRED] Shared secret for webhook auth
N8N_SIGNING_SECRET=                     # [REQUIRED] HMAC signing secret
N8N_TIMEOUT_SECONDS=15.0
N8N_MAX_ATTEMPTS=3
N8N_BACKOFF_BASE_SECONDS=2.0
N8N_ENABLED=false                          # Set true when n8n webhook is ready
DEADLETTER_PATH=./data/payloads/deadletter

# --- Security ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_SESSION_PER_MINUTE=20
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_SESSION_CREATE_PER_HOUR=10
ADMIN_API_KEY=                          # Required when ADMIN_ROUTES_ENABLED=true
ADMIN_ROUTES_ENABLED=false
TRUSTED_HOSTS=*

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
TELEMETRY_ENABLED=true
COST_PER_1K_INPUT_TOKENS=0.00015
COST_PER_1K_OUTPUT_TOKENS=0.00060
LOG_SAMPLE_RATE=1.0
